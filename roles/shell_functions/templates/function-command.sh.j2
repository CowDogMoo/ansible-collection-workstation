#!/bin/sh
# managed by cowdogmoo.workstation.shell_functions: {{ item.name }}
#
# Runs the `{{ item.name }}` shell function from {{ item.file }} in shells that never
# read ~/.zshrc, such as the non-interactive shells coding agents run commands in.
# An interactive shell already has the function, which takes precedence over this
# file, so interactive behavior does not change.
lib={{ (shell_functions_dest ~ '/' ~ item.file) | quote }}
if [ ! -r "$lib" ]; then
  echo "{{ item.name }}: $lib not found" >&2
  exit 127
fi
shell=$(command -v zsh || command -v bash) || {
  echo "{{ item.name }}: needs zsh or bash" >&2
  exit 127
}
# The mise shims go first on PATH so the tools the function calls are the
# mise-managed ones, whatever order the calling shell left PATH in. The function
# is called only once the library has defined it: as a bare name it would
# otherwise resolve to this file again.
exec "$shell" -c '
export PATH="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims:$PATH"
. "$0"
if ! typeset -f {{ item.name }} >/dev/null; then
  echo "{{ item.name }}: $0 does not define {{ item.name }}" >&2
  exit 127
fi
{{ item.name }} "$@"
' "$lib" "$@"
